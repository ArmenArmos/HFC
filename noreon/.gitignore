*.tsbuildinfo
next-env.d.ts
.superpowers/

# End-to-end suite
e2e/.state/
test-results/
playwright-report/

# Zoe conversation suite runs (real transcripts of fictional members, kept outside git)
.zoe-conversation-runs/
.merge-briefs/
