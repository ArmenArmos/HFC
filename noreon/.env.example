# Public site origin. Used for canonical URLs, sitemap.xml, robots.txt and
# Open Graph. Must be the real origin in production or crawlers get relative URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API. The anon key is public by design; every
# query it makes is constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The homepage request form. A Google Apps Script web app bound to the requests
# spreadsheet, which appends a row. Neither is NEXT_PUBLIC_, so neither reaches
# the browser; the form submits through a server action. Creating the sheet,
# deploying the script and generating the secret are in docs/sheets/README.md.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Real registration stays closed until the hosted Auth provider and receipt are checked.
NOREON_REGISTRATION_ENABLED=false
# sms | twilio-whatsapp | meta-whatsapp-hook | brevo-sms-hook | twilio-sms-hook | twilio-verify-hook
NOREON_PHONE_OTP_PROVIDER=
NOREON_REGISTRATION_ALLOWED_PREFIXES=+374
NOREON_PHONE_OTP_HOOK_READY=false
NOREON_REAL_MEMBER_REVIEW_ENABLED=false

# Server-only Brevo/Supabase Send SMS hook configuration. Never use NEXT_PUBLIC_ keys.
NOREON_BREVO_API_KEY=
NOREON_BREVO_SMS_SENDER=
NOREON_BREVO_SMS_READY=false
NOREON_SUPABASE_SMS_HOOK_SECRET=
# Optional override: omit entirely to use SUPABASE_SERVICE_ROLE_KEY. Empty/invalid overrides fail closed.
# NOREON_MESSAGING_SERVICE_ROLE_KEY=

# Server-only Twilio SMS hook and notice credentials. Keep readiness false until live acceptance.
NOREON_TWILIO_ACCOUNT_SID=
NOREON_TWILIO_API_KEY_SID=
NOREON_TWILIO_API_KEY_SECRET=
NOREON_TWILIO_SMS_FROM=
NOREON_TWILIO_SMS_READY=false
# Separate restricted Verify credentials; custom-code service, no fallback to messaging credentials.
NOREON_TWILIO_VERIFY_SERVICE_SID=
NOREON_TWILIO_VERIFY_API_KEY_SID=
NOREON_TWILIO_VERIFY_API_KEY_SECRET=
NOREON_TWILIO_VERIFY_READY=false
NOREON_TWILIO_WHATSAPP_READY=false
# Account AuthToken is optional for sends, required to verify Twilio callbacks.
NOREON_TWILIO_AUTH_TOKEN=

# Dedicated doctor Telegram connection (server only, dark by default).
NOREON_DOCTOR_TELEGRAM=
NOREON_DOCTOR_TELEGRAM_KEY=

# Clinical review (WP T), each dark unless exactly true: physician-set BP targets and the personal BP comparison,
# risk tiers with the care-team worklist (cron /api/internal/risk-tiers), and the BP/LDL trend sweep
# (cron /api/internal/clinical-anomalies; raising care-queue tasks also needs NOREON_ZOE_APP_V3).
NOREON_BP_TARGETS=
NOREON_RISK_TIERS=
NOREON_CLINICAL_ANOMALIES=

# Realtime chat signals (WP R), dark unless exactly true: /api/realtime/token issues the caller's own session token for
# Supabase Realtime (realtime_signals, ids only); off, every chat keeps its HTTP polling. The database writes signals
# either way and the cron /api/internal/realtime-signals deletes those older than two days.
NOREON_REALTIME=
