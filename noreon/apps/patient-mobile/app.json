{
  "expo": {
    "name": "Noreon",
    "slug": "noreon-patient",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "health.noreon.patient"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "health.noreon.patient"
    },
    "scheme": "noreon",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
